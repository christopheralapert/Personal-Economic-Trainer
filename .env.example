# Local synthetic preview. Keep real credentials in your ignored .env.
MONEYLENS_ENVIRONMENT=development
MONEYLENS_APP_ORIGIN=http://127.0.0.1:3000
MONEYLENS_API_URL=http://127.0.0.1:8000
MONEYLENS_DEMO_API_URL=http://127.0.0.1:8001
MONEYLENS_AUTH_ENABLED=false
MONEYLENS_ALLOW_DEMO=true
MONEYLENS_IMPORTS_ENABLED=false
MONEYLENS_LIVE_BANKING_ENABLED=false
MONEYLENS_MODEL_ENABLED=false
MONEYLENS_MODEL_BILLING_POLICY=free_only

# Optional hosted services are off. A key alone must not enable traffic.
GEMINI_API_KEY=
MONEY_COACH_PUBLIC_GEMINI_ENABLED=false
MONEY_COACH_PUBLIC_AI_ORIGINS=http://127.0.0.1:3000
# Absolute path to an ignored, private usage ledger is required before opt-in.
MONEY_COACH_MODEL_USAGE_PATH=
MONEY_COACH_GEMINI_VOICE_ENABLED=false
MONEY_COACH_VOICE_LEDGER_PATH=
MONEY_COACH_VOICE_MAX_REQUESTS=20
MONEY_COACH_VOICE_REQUEST_POLICY=bounded
