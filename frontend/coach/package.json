{
  "name": "@moneylens/coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "package:demo": "node scripts/package-demo.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "benchmark:engine": "node scripts/benchmark-engine.mjs",
    "predev": "node scripts/generate-pwa.mjs",
    "prebuild": "node scripts/generate-pwa.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "ai:check": "node --env-file-if-exists=../../.env scripts/check-ai.mjs",
    "ai:evaluate": "node --env-file-if-exists=../../.env scripts/evaluate-ai.mjs",
    "ai:preview": "node --env-file-if-exists=../../.env scripts/preview-ai.mjs",
    "ai:browser": "node scripts/evaluate-browser-ai.mjs",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "phone:preview": "node scripts/preview-phone.mjs",
    "test:phone": "node --test tests/phone/*.test.mjs && playwright test --config playwright.phone.config.ts",
    "test": "vitest run && node --test tests/pwa/*.test.mjs tests/ai/*.test.mjs",
    "lint": "eslint src && node scripts/lint-px.mjs",
    "lint:px": "node scripts/lint-px.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/react": "^4.0.167",
    "@tailwindcss/postcss": "^4.3.4",
    "@tanstack/react-virtual": "3.14.26",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jiti": "2.7.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
