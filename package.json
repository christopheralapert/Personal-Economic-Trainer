{
  "name": "personal-economic-trainer",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/web", "complete-ui"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web --hostname 127.0.0.1",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start apps/web --hostname 127.0.0.1",
    "dev:complete": "npm run dev --workspace complete-ui",
    "build:complete": "npm run build --workspace complete-ui",
    "dev:coach": "npm run dev:complete",
    "build:coach": "npm run build:complete",
    "dev:api": "node --env-file-if-exists=.env scripts/run_api.mjs",
    "dev:demo-api": "node scripts/run_demo_api.mjs",
    "build:web": "node scripts/generate_pwa.mjs && npm run build --workspace @moneylens/web",
    "build:legacy": "npm run build:web",
    "build": "npm run build:complete && npm run build:web",
    "test": "npm run test --workspace complete-ui",
    "typecheck": "npm run typecheck --workspace @moneylens/web && npm run typecheck --workspace complete-ui",
    "test:web": "playwright test",
    "test:web-money": "node --experimental-strip-types --test tests/web/*.test.ts",
    "test:worker": "node --test tests/pwa/*.test.mjs",
    "contracts:types": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts",
    "dev:prototype": "vite",
    "build:prototype": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@playwright/test": "1.64.1",
    "openapi-typescript": "6.7.6",
    "sharp": "0.35.5"
  },
  "overrides": { "undici": "6.29.1" }
}
