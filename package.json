{
  "name": "personal-economic-trainer",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend/web", "frontend/coach"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev frontend/web --hostname 127.0.0.1",
    "start": "node --env-file-if-exists=.env node_modules/next/dist/bin/next start frontend/web --hostname 127.0.0.1",
    "dev:complete": "npm run dev:coach",
    "build:complete": "npm run build:coach",
    "dev:coach": "npm run dev --workspace @moneylens/coach",
    "build:coach": "npm run build --workspace @moneylens/coach",
    "dev:api": "node --env-file-if-exists=.env scripts/run_api.mjs",
    "dev:demo-api": "node scripts/run_demo_api.mjs",
    "build:web": "node scripts/generate_pwa.mjs && npm run build --workspace @moneylens/web",
    "build:legacy": "npm run build:web",
    "build": "npm run build:coach && npm run build:web",
    "test": "npm run test --workspace @moneylens/coach",
    "typecheck": "npm run typecheck --workspace @moneylens/web && npm run typecheck --workspace @moneylens/coach",
    "test:structure": "node --test tests/structure/*.test.mjs",
    "test:web": "playwright test --config tests/config/playwright.config.ts",
    "test:web-coach": "playwright test --config tests/config/playwright.coach.config.ts",
    "test:web:legal": "playwright test --config tests/config/playwright.legal.config.ts",
    "test:web:container": "playwright test --config tests/config/playwright.container.config.ts",
    "test:web-money": "node --experimental-strip-types --test tests/web/*.test.ts",
    "test:worker": "node --test tests/pwa/*.test.mjs",
    "contracts:types": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts",
    "infra:up": "docker compose -f deploy/compose.yaml up -d",
    "infra:down": "docker compose -f deploy/compose.yaml down",
    "infra:check": "docker compose -f deploy/compose.yaml config --quiet && docker compose -f deploy/compose.local.yaml config --quiet",
    "dev:prototype": "vite frontend/prototype",
    "build:prototype": "vite build frontend/prototype",
    "preview": "vite preview frontend/prototype"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@playwright/test": "1.64.1",
    "openapi-typescript": "6.7.6",
    "sharp": "0.35.5"
  },
  "overrides": { "undici": "6.29.1" }
}
