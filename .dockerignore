# An allowlist keeps local credentials, Git history, customer files and large
# generated scale inputs out of the build context, not just the final image.
**
!package.json
!package-lock.json
!apps/
apps/**
!apps/web/
apps/web/**
!apps/web/package.json
!complete-ui/
complete-ui/**
!complete-ui/package.json
!complete-ui/postcss.config.mjs
!complete-ui/src/
!complete-ui/src/**
!complete-ui/data/
!complete-ui/data/*.json
!complete-ui/scripts/
!complete-ui/scripts/*.mjs
!apps/web/postcss.config.mjs
!apps/web/i18n/
!apps/web/i18n/**
!apps/web/tsconfig.json
!apps/web/next-env.d.ts
!apps/web/next.config.ts
!apps/web/app/
!apps/web/app/**
!apps/web/components/
!apps/web/components/**
!apps/web/public/
!apps/web/public/**
!packages/
packages/**
!packages/contracts/
packages/contracts/**
!packages/contracts/api.d.ts
!scripts/
scripts/**
!scripts/generate_pwa.mjs
!services/
services/**
!services/api/
services/api/**
!services/api/requirements.txt
!services/api/app/
!services/api/app/**
!services/workers/
services/workers/**
!services/workers/run.py
!fixtures/
fixtures/**
!fixtures/synthetic/
fixtures/synthetic/**
!fixtures/synthetic/demo.v1.json
!fixtures/public/
!fixtures/public/**
!db/
db/**
!db/migrations/
!db/migrations/**
!alembic.ini
!deploy/
deploy/**
!deploy/*.Dockerfile
# These denials also apply inside an otherwise allowed source directory.
**/.env
**/.env.*
**/AGENTS.md
**/agent.md
**/*.pem
**/*.key
**/node_modules
**/.next
**/.cache
**/.cache/**
**/.pytest_cache
**/.pytest_cache/**
**/.venv
**/.git
**/.agents
**/__pycache__
**/*.pyc
