# An allowlist keeps local credentials, Git history, customer files and large
# generated scale inputs out of the build context, not just the final image.
**
!package.json
!package-lock.json
!frontend/
frontend/**
!frontend/web/
frontend/web/**
!frontend/web/package.json
!frontend/coach/
frontend/coach/**
!frontend/coach/package.json
!frontend/coach/postcss.config.mjs
!frontend/coach/src/
!frontend/coach/src/**
!frontend/coach/data/
!frontend/coach/data/*.json
!frontend/coach/scripts/
!frontend/coach/scripts/*.mjs
!frontend/web/postcss.config.mjs
!frontend/web/i18n/
!frontend/web/i18n/**
!frontend/web/tsconfig.json
!frontend/web/next-env.d.ts
!frontend/web/next.config.ts
!frontend/web/app/
!frontend/web/app/**
!frontend/web/components/
!frontend/web/components/**
!frontend/web/lib/
!frontend/web/lib/**
!frontend/web/public/
!frontend/web/public/**
!packages/
packages/**
!packages/contracts/
packages/contracts/**
!packages/contracts/api.d.ts
!scripts/
scripts/**
!scripts/generate_pwa.mjs
!backend/
backend/**
!backend/api/
backend/api/**
!backend/api/requirements.txt
!backend/api/app/
!backend/api/app/**
!backend/workers/
backend/workers/**
!backend/workers/run.py
!fixtures/
fixtures/**
!fixtures/synthetic/
fixtures/synthetic/**
!fixtures/synthetic/demo.v1.json
!fixtures/public/
!fixtures/public/**
!backend/db/
backend/db/**
!backend/db/migrations/
!backend/db/migrations/**
!alembic.ini
!deploy/
deploy/**
!deploy/*.Dockerfile
# These denials also apply inside an otherwise allowed source directory.
**/.env
**/.env.*
**/AGENTS.md
**/agent.md
**/*.pem
**/*.key
**/node_modules
**/.next
**/.cache
**/.cache/**
